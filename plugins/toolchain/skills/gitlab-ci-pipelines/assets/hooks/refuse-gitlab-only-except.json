{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/refuse-gitlab-only-except.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
