{
  "name": "greenblacked-ai",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../dist/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "staging": {
      "name": "greenblacked-ai-staging",
      "compatibility_date": "2026-10-01",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "stage.ai.szolotov.com",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "../dist/site",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      }
    }
  }
}
